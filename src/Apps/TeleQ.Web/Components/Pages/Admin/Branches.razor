@page "/admin/branches"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer
@inject TeleQApiClient Api
@inject NavigationManager Navigation

<PageTitle>Manage Branches</PageTitle>

<h1 class="mb-4">Branches</h1>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Manage active branches and contact information.</p>
    <button class="btn btn-primary" @onclick="CreateNew"><i class="bi bi-plus-circle me-2"></i>Add Branch</button>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (_branches.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No branches found.</td></tr>
                }
                else
                {
                    @foreach (var branch in _branches)
                    {
                        <tr>
                            <td class="fw-semibold">@branch.Name</td>
                            <td>@branch.Address</td>
                            <td>@(branch.PhoneNumber ?? "—")</td>
                            <td><span class="badge bg-success-subtle text-success-emphasis">@(branch.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" @onclick="() => EditBranch(branch)">Edit</button>
                                    <button class="btn btn-outline-danger" @onclick="() => DeleteBranchAsync(branch.Id)">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingId is null ? "Add Branch" : "Edit Branch")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="_name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input class="form-control" @bind="_address" />
                    </div>
                    <div>
                        <label class="form-label">Phone Number</label>
                        <input class="form-control" @bind="_phone" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveAsync">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<BranchResponse> _branches = [];
    private Guid? _editingId;
    private string _name = string.Empty;
    private string _address = string.Empty;
    private string? _phone;
    private string? _error;
    private bool _showModal;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _branches.Clear();
            _branches.AddRange(await Api.GetBranchesAsync() ?? []);
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void CreateNew()
    {
        _editingId = null;
        _name = string.Empty;
        _address = string.Empty;
        _phone = null;
        _showModal = true;
    }

    private void EditBranch(BranchResponse branch)
    {
        _editingId = branch.Id;
        _name = branch.Name;
        _address = branch.Address;
        _phone = branch.PhoneNumber;
        _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private async Task SaveAsync()
    {
        try
        {
            if (_editingId is null)
            {
                await Api.CreateBranchAsync(new CreateBranchRequest(_name, _address, _phone));
            }
            else
            {
                await Api.UpdateBranchAsync(_editingId.Value, new UpdateBranchRequest(_name, _address, _phone, true));
            }

            _showModal = false;
            await LoadAsync();
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteBranchAsync(Guid id)
    {
        try
        {
            await Api.DeleteBranchAsync(id);
            await LoadAsync();
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private bool HandleAuthFailure(HttpRequestException ex)
    {
        if (ex.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
        {
            var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
            return true;
        }

        return false;
    }
}
