@page "/admin/branches"
@attribute [Authorize(Roles = "admin")]
@inject TeleQApiClient Api
@inject NavigationManager Navigation

<PageTitle>Manage Branches</PageTitle>

<h1 class="mb-4">Branches</h1>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <Alert Color="Color.Danger" ShowDismiss="true">@_error</Alert>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Manage active branches and contact information.</p>
    <Button Color="Color.Primary" Icon="bi bi-plus-circle" Text="Add Branch" OnClick="CreateNew" />
</div>

<Table TItem="BranchResponse" Items="@_branches" IsBordered="true" IsStriped="true" IsResponsive="true"
       CreateItemCallback="@(() => new BranchResponse(Guid.Empty, string.Empty, string.Empty, null, false))">
    <TableColumns>
        <TableColumn Field="@context.Name" FieldExpression="@(() => context.Name)" Text="Name" />
        <TableColumn Field="@context.Address" FieldExpression="@(() => context.Address)" Text="Address" />
        <TableColumn Field="@context.PhoneNumber" FieldExpression="@(() => context.PhoneNumber)" Text="Phone">
            <Template Context="ctx">@(ctx.Value ?? "—")</Template>
        </TableColumn>
        <TableColumn Field="@context.IsActive" FieldExpression="@(() => context.IsActive)" Text="Status">
            <Template Context="ctx">
                <span class="badge @(ctx.Value ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                    @(ctx.Value ? "Active" : "Inactive")
                </span>
            </Template>
        </TableColumn>
        <TableColumn Field="@context.Id" FieldExpression="@(() => context.Id)" Text="Actions" Align="Alignment.Right">
            <Template Context="ctx">
                <div class="d-flex gap-1 justify-content-end">
                    <Button Color="Color.Primary" Size="Size.Small" Text="Edit" OnClick="@(() => EditBranch(ctx.Row))" />
                    <Button Color="Color.Danger" Size="Size.Small" Text="Delete" OnClick="@(() => DeleteBranchAsync(ctx.Row.Id))" />
                </div>
            </Template>
        </TableColumn>
    </TableColumns>
</Table>

<Modal @ref="_modal">
    <ModalDialog Title="@(_editingId is null ? "Add Branch" : "Edit Branch")" ShowCloseButton="false" Size="Size.Large">
        <BodyTemplate>
            <div class="mb-3">
                <label class="form-label">Name</label>
                <BootstrapInput TValue="string" @bind-Value="_name" PlaceHolder="Branch name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Address</label>
                <BootstrapInput TValue="string" @bind-Value="_address" PlaceHolder="Branch address" />
            </div>
            <div>
                <label class="form-label">Phone Number</label>
                <BootstrapInput TValue="string?" @bind-Value="_phone" PlaceHolder="Phone (optional)" />
            </div>
        </BodyTemplate>
        <FooterContentTemplate>
            <Button Color="Color.Secondary" Text="Cancel" OnClick="CloseModal" />
            <Button Color="Color.Primary" Text="Save" OnClick="SaveAsync" />
        </FooterContentTemplate>
    </ModalDialog>
</Modal>

@code {
    private readonly List<BranchResponse> _branches = [];
    private Modal? _modal;
    private Guid? _editingId;
    private string _name = string.Empty;
    private string _address = string.Empty;
    private string? _phone;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _branches.Clear();
            _branches.AddRange(await Api.GetBranchesAsync() ?? []);
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreateNew()
    {
        _editingId = null;
        _name = string.Empty;
        _address = string.Empty;
        _phone = null;
        await _modal!.Show();
    }

    private async Task EditBranch(BranchResponse branch)
    {
        _editingId = branch.Id;
        _name = branch.Name;
        _address = branch.Address;
        _phone = branch.PhoneNumber;
        await _modal!.Show();
    }

    private async Task CloseModal() => await _modal!.Close();

    private async Task SaveAsync()
    {
        try
        {
            if (_editingId is null)
            {
                await Api.CreateBranchAsync(new CreateBranchRequest(_name, _address, _phone));
            }
            else
            {
                await Api.UpdateBranchAsync(_editingId.Value, new UpdateBranchRequest(_name, _address, _phone, true));
            }

            await _modal!.Close();
            await LoadAsync();
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteBranchAsync(Guid id)
    {
        try
        {
            await Api.DeleteBranchAsync(id);
            await LoadAsync();
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private bool HandleAuthFailure(HttpRequestException ex)
    {
        if (ex.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
        {
            var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
            return true;
        }

        return false;
    }
}
