@page "/admin/services"
@attribute [Authorize(Roles = "admin")]
@inject TeleQApiClient Api
@inject NavigationManager Navigation

<PageTitle>Manage Services</PageTitle>

<h1 class="mb-4">Services</h1>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <Alert Color="Color.Danger" ShowDismiss="true">@_error</Alert>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Branch</label>
                <Select TValue="string?" Items="@BranchItems" Value="@_selectedBranchId" ValueChanged="@OnBranchChangedAsync" PlaceHolder="Select a branch" />
            </div>
            <div class="col-md-6 d-grid">
                <Button Color="Color.Primary" Icon="bi bi-plus-circle" Text="Add Service" OnClick="CreateNew" Disabled="@(!Guid.TryParse(_selectedBranchId, out _))" />
            </div>
        </div>
    </div>
</div>

<Table TItem="ServiceResponse" Items="@_services" IsBordered="true" IsStriped="true" IsResponsive="true"
       CreateItemCallback="@(() => new ServiceResponse(Guid.Empty, string.Empty, null, 0, Guid.Empty, false))">
    <TableColumns>
        <TableColumn Field="@context.Name" FieldExpression="@(() => context.Name)" Text="Name" />
        <TableColumn Field="@context.Description" FieldExpression="@(() => context.Description)" Text="Description">
            <Template Context="ctx">@(ctx.Value ?? "—")</Template>
        </TableColumn>
        <TableColumn Field="@context.EstimatedDurationMinutes" FieldExpression="@(() => context.EstimatedDurationMinutes)" Text="Duration">
            <Template Context="ctx">@ctx.Value min</Template>
        </TableColumn>
        <TableColumn Field="@context.IsActive" FieldExpression="@(() => context.IsActive)" Text="Status">
            <Template Context="ctx">
                <span class="badge @(ctx.Value ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                    @(ctx.Value ? "Active" : "Inactive")
                </span>
            </Template>
        </TableColumn>
        <TableColumn Field="@context.Id" FieldExpression="@(() => context.Id)" Text="Actions" Align="Alignment.Right">
            <Template Context="ctx">
                <div class="d-flex gap-1 justify-content-end">
                    <Button Color="Color.Primary" Size="Size.Small" Text="Edit" OnClick="@(() => EditService(ctx.Row))" />
                    <Button Color="Color.Danger" Size="Size.Small" Text="Delete" OnClick="@(() => DeleteServiceAsync(ctx.Row.Id))" />
                </div>
            </Template>
        </TableColumn>
    </TableColumns>
</Table>

<Modal @ref="_modal">
    <ModalDialog Title="@(_editingId is null ? "Add Service" : "Edit Service")" ShowCloseButton="false">
        <BodyTemplate>
            <div class="mb-3">
                <label class="form-label">Name</label>
                <BootstrapInput TValue="string" @bind-Value="_name" PlaceHolder="Service name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" rows="3" @bind="_description" placeholder="Description (optional)"></textarea>
            </div>
            <div>
                <label class="form-label">Estimated Duration (minutes)</label>
                <input type="number" min="1" class="form-control" @bind="_estimatedDurationMinutes" />
            </div>
        </BodyTemplate>
        <FooterContentTemplate>
            <Button Color="Color.Secondary" Text="Cancel" OnClick="CloseModal" />
            <Button Color="Color.Primary" Text="Save" OnClick="SaveAsync" />
        </FooterContentTemplate>
    </ModalDialog>
</Modal>

@code {
    private readonly List<BranchResponse> _branches = [];
    private readonly List<ServiceResponse> _services = [];
    private Modal? _modal;
    private string? _selectedBranchId;
    private Guid? _editingId;
    private string _name = string.Empty;
    private string? _description;
    private int _estimatedDurationMinutes = 10;
    private string? _error;

    private IEnumerable<SelectedItem> BranchItems =>
        _branches.Select(b => new SelectedItem(b.Id.ToString(), b.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _branches.AddRange(await Api.GetBranchesAsync() ?? []);
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnBranchChangedAsync(string? value)
    {
        _selectedBranchId = value;
        await LoadServicesAsync();
    }

    private async Task LoadServicesAsync()
    {
        _services.Clear();
        if (!Guid.TryParse(_selectedBranchId, out var branchId))
        {
            return;
        }

        try
        {
            _services.AddRange(await Api.GetServicesAsync(branchId) ?? []);
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreateNew()
    {
        _editingId = null;
        _name = string.Empty;
        _description = null;
        _estimatedDurationMinutes = 10;
        await _modal!.Show();
    }

    private async Task EditService(ServiceResponse service)
    {
        _editingId = service.Id;
        _name = service.Name;
        _description = service.Description;
        _estimatedDurationMinutes = service.EstimatedDurationMinutes;
        await _modal!.Show();
    }

    private async Task CloseModal() => await _modal!.Close();

    private async Task SaveAsync()
    {
        if (!Guid.TryParse(_selectedBranchId, out var branchId))
        {
            _error = "Select a branch first.";
            return;
        }

        try
        {
            if (_editingId is null)
            {
                await Api.CreateServiceAsync(branchId, new CreateServiceRequest(_name, _description, _estimatedDurationMinutes));
            }
            else
            {
                await Api.UpdateServiceAsync(_editingId.Value, new UpdateServiceRequest(_name, _description, _estimatedDurationMinutes, true));
            }

            await _modal!.Close();
            await LoadServicesAsync();
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteServiceAsync(Guid id)
    {
        try
        {
            await Api.DeleteServiceAsync(id);
            await LoadServicesAsync();
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private bool HandleAuthFailure(HttpRequestException ex)
    {
        if (ex.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
        {
            var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
            return true;
        }

        return false;
    }
}
