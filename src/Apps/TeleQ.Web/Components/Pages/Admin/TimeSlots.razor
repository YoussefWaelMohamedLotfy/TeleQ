@page "/admin/timeslots"
@attribute [Authorize(Roles = "admin")]
@inject TeleQApiClient Api
@inject NavigationManager Navigation

<PageTitle>Manage Time Slots</PageTitle>

<h1 class="mb-4">Time Slots</h1>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <Alert Color="Color.Danger" ShowDismiss="true">@_error</Alert>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Branch</label>
                <Select TValue="string?" Items="@BranchItems" Value="@_selectedBranchId" ValueChanged="@OnBranchChangedAsync" PlaceHolder="Select a branch" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Service</label>
                <Select TValue="string?" Items="@ServiceItems" Value="@_selectedServiceId" ValueChanged="@OnServiceChangedAsync" PlaceHolder="Select a service" IsDisabled="@(string.IsNullOrEmpty(_selectedBranchId))" />
            </div>
            <div class="col-md-4 d-grid">
                <Button Color="Color.Primary" Icon="bi bi-plus-circle" Text="Add Time Slot" OnClick="CreateNew" Disabled="@(!Guid.TryParse(_selectedBranchId, out _) || !Guid.TryParse(_selectedServiceId, out _))" />
            </div>
        </div>
    </div>
</div>

<Table TItem="TimeSlotResponse" Items="@_timeSlots" IsBordered="true" IsStriped="true" IsResponsive="true"
       CreateItemCallback="@(() => new TimeSlotResponse(Guid.Empty, Guid.Empty, Guid.Empty, TimeOnly.MinValue, TimeOnly.MinValue, 0, 0, false, false, null))">
    <TableColumns>
        <TableColumn Field="@context.StartTime" FieldExpression="@(() => context.StartTime)" Text="Start">
            <Template Context="ctx">@ctx.Value.ToString("HH:mm")</Template>
        </TableColumn>
        <TableColumn Field="@context.EndTime" FieldExpression="@(() => context.EndTime)" Text="End">
            <Template Context="ctx">@ctx.Value.ToString("HH:mm")</Template>
        </TableColumn>
        <TableColumn Field="@context.Capacity" FieldExpression="@(() => context.Capacity)" Text="Capacity" />
        <TableColumn Field="@context.BookedCount" FieldExpression="@(() => context.BookedCount)" Text="Booked" />
        <TableColumn Field="@context.IsRecurring" FieldExpression="@(() => context.IsRecurring)" Text="Recurring">
            <Template Context="ctx">@(ctx.Value ? "Yes" : "No")</Template>
        </TableColumn>
        <TableColumn Field="@context.DayOfWeek" FieldExpression="@(() => context.DayOfWeek)" Text="Day / Date">
            <Template Context="ctx">
                @(ctx.Row.IsRecurring ? ctx.Row.DayOfWeek?.ToString() : ctx.Row.Date?.ToShortDateString())
            </Template>
        </TableColumn>
        <TableColumn Field="@context.Id" FieldExpression="@(() => context.Id)" Text="Actions" Align="Alignment.Right">
            <Template Context="ctx">
                <Button Color="Color.Danger" Size="Size.Small" Text="Delete" OnClick="@(() => DeleteAsync(ctx.Row.Id))" />
            </Template>
        </TableColumn>
    </TableColumns>
</Table>

<Modal @ref="_modal">
    <ModalDialog Title="Add Time Slot" ShowCloseButton="false">
        <BodyTemplate>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Start Time</label>
                    <input type="text" class="form-control" placeholder="09:00" @bind="_startTime" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">End Time</label>
                    <input type="text" class="form-control" placeholder="09:30" @bind="_endTime" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Capacity</label>
                    <input type="number" min="1" class="form-control" @bind="_capacity" />
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <Switch @bind-Value="_isRecurring" ShowLabel="true" DisplayText="Recurring weekly" />
                </div>
                @if (_isRecurring)
                {
                    <div class="col-12">
                        <label class="form-label">Day of Week</label>
                        <Select TValue="string?" Items="@DayItems" Value="@_dayOfWeek" ValueChanged="@(v => _dayOfWeek = v)" PlaceHolder="Select day" />
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <label class="form-label">Specific Date</label>
                        <input type="text" class="form-control" placeholder="2025-01-31" @bind="_date" />
                    </div>
                }
            </div>
        </BodyTemplate>
        <FooterContentTemplate>
            <Button Color="Color.Secondary" Text="Cancel" OnClick="CloseModal" />
            <Button Color="Color.Primary" Text="Save" OnClick="SaveAsync" />
        </FooterContentTemplate>
    </ModalDialog>
</Modal>

@code {
    private readonly List<BranchResponse> _branches = [];
    private readonly List<ServiceResponse> _services = [];
    private readonly List<TimeSlotResponse> _timeSlots = [];
    private Modal? _modal;
    private string? _selectedBranchId;
    private string? _selectedServiceId;
    private string _startTime = "09:00";
    private string _endTime = "09:30";
    private int _capacity = 1;
    private bool _isRecurring = true;
    private string? _dayOfWeek;
    private string? _date;
    private string? _error;

    private IEnumerable<SelectedItem> BranchItems =>
        _branches.Select(b => new SelectedItem(b.Id.ToString(), b.Name));

    private IEnumerable<SelectedItem> ServiceItems =>
        _services.Select(s => new SelectedItem(s.Id.ToString(), s.Name));

    private IEnumerable<SelectedItem> DayItems =>
        Enum.GetValues<DayOfWeek>().Select(d => new SelectedItem(d.ToString(), d.ToString()));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _branches.AddRange(await Api.GetBranchesAsync() ?? []);
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnBranchChangedAsync(string? value)
    {
        _selectedBranchId = value;
        _selectedServiceId = null;
        _services.Clear();
        _timeSlots.Clear();

        if (!Guid.TryParse(_selectedBranchId, out var branchId))
        {
            return;
        }

        try
        {
            _services.AddRange(await Api.GetServicesAsync(branchId) ?? []);
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnServiceChangedAsync(string? value)
    {
        _selectedServiceId = value;
        await LoadTimeSlotsAsync();
    }

    private async Task LoadTimeSlotsAsync()
    {
        _timeSlots.Clear();
        if (!Guid.TryParse(_selectedServiceId, out var serviceId))
        {
            return;
        }

        try
        {
            _timeSlots.AddRange(await Api.GetTimeSlotsAsync(serviceId) ?? []);
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreateNew()
    {
        _startTime = "09:00";
        _endTime = "09:30";
        _capacity = 1;
        _isRecurring = true;
        _dayOfWeek = DayOfWeek.Monday.ToString();
        _date = null;
        await _modal!.Show();
    }

    private async Task CloseModal() => await _modal!.Close();

    private async Task SaveAsync()
    {
        if (!Guid.TryParse(_selectedBranchId, out var branchId) || !Guid.TryParse(_selectedServiceId, out var serviceId))
        {
            _error = "Select both branch and service first.";
            return;
        }

        try
        {
            var request = new CreateTimeSlotRequest(
                TimeOnly.Parse(_startTime),
                TimeOnly.Parse(_endTime),
                _capacity,
                _isRecurring,
                _isRecurring && Enum.TryParse<DayOfWeek>(_dayOfWeek, out var day) ? day : null,
                branchId,
                !_isRecurring && DateOnly.TryParse(_date, out var specificDate) ? specificDate : null);

            await Api.CreateTimeSlotAsync(serviceId, request);
            await _modal!.Close();
            await LoadTimeSlotsAsync();
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        try
        {
            await Api.DeleteTimeSlotAsync(id);
            await LoadTimeSlotsAsync();
        }
        catch (HttpRequestException ex) when (HandleAuthFailure(ex))
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private bool HandleAuthFailure(HttpRequestException ex)
    {
        if (ex.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
        {
            var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
            return true;
        }

        return false;
    }
}
