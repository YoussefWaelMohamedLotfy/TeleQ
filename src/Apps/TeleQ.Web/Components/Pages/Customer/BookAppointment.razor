@page "/appointment"
@attribute [AllowAnonymous]
@inject TeleQApiClient Api
@inject NavigationManager Navigation

<PageTitle>Book Appointment</PageTitle>

<h1 class="mb-4">Book an Appointment</h1>

@if (_loading)
{
    <div class="d-flex align-items-center gap-2 text-muted">
        <Spinner Color="Color.Secondary" />
        <span>Loading appointment options...</span>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <Alert Color="Color.Danger" ShowDismiss="true">@_error</Alert>
    }

    @if (!string.IsNullOrWhiteSpace(_success))
    {
        <Alert Color="Color.Success">@_success</Alert>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Phone Number</label>
                    <BootstrapInput TValue="string" @bind-Value="_phoneNumber" PlaceHolder="01xxxxxxxxx" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Branch</label>
                    <Select TValue="string?" Items="@BranchItems" Value="@_selectedBranchId" ValueChanged="@OnBranchChangedAsync" PlaceHolder="Select a branch" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Service</label>
                    <Select TValue="string?" Items="@ServiceItems" Value="@_selectedServiceId" ValueChanged="@OnServiceChangedAsync" PlaceHolder="Select a service" IsDisabled="@(string.IsNullOrEmpty(_selectedBranchId))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Time Slot</label>
                    <Select TValue="string?" Items="@TimeSlotItems" Value="@_selectedTimeSlotId" ValueChanged="@(v => _selectedTimeSlotId = v)" PlaceHolder="Select a time slot" IsDisabled="@(string.IsNullOrEmpty(_selectedServiceId))" />
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <Button Color="Color.Primary" Icon="bi bi-calendar-check" Text="Book Appointment" OnClick="SubmitAsync" Disabled="@_submitting" />
                <a class="btn btn-outline-secondary" href="/">Cancel</a>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<BranchResponse> _branches = [];
    private readonly List<ServiceResponse> _services = [];
    private readonly List<TimeSlotResponse> _timeSlots = [];
    private string? _selectedBranchId;
    private string? _selectedServiceId;
    private string? _selectedTimeSlotId;
    private string _phoneNumber = string.Empty;
    private string? _error;
    private string? _success;
    private bool _loading = true;
    private bool _submitting;

    private IEnumerable<SelectedItem> BranchItems =>
        _branches.Select(b => new SelectedItem(b.Id.ToString(), b.Name));

    private IEnumerable<SelectedItem> ServiceItems =>
        _services.Select(s => new SelectedItem(s.Id.ToString(), $"{s.Name} ({s.EstimatedDurationMinutes} min)"));

    private IEnumerable<SelectedItem> TimeSlotItems =>
        _timeSlots.Select(slot => new SelectedItem(slot.Id.ToString(), FormatTimeSlot(slot)));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _branches.AddRange(await Api.GetBranchesAsync() ?? []);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnBranchChangedAsync(string? value)
    {
        _selectedBranchId = value;
        _selectedServiceId = null;
        _selectedTimeSlotId = null;
        _services.Clear();
        _timeSlots.Clear();

        if (!Guid.TryParse(_selectedBranchId, out var branchId))
        {
            return;
        }

        try
        {
            _services.AddRange(await Api.GetServicesAsync(branchId) ?? []);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnServiceChangedAsync(string? value)
    {
        _selectedServiceId = value;
        _selectedTimeSlotId = null;
        _timeSlots.Clear();

        if (!Guid.TryParse(_selectedServiceId, out var serviceId))
        {
            return;
        }

        try
        {
            _timeSlots.AddRange((await Api.GetTimeSlotsAsync(serviceId) ?? []).Where(slot => slot.AvailableCount > 0 || slot.Capacity > slot.BookedCount));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        _success = null;

        if (!Guid.TryParse(_selectedBranchId, out var branchId)
            || !Guid.TryParse(_selectedServiceId, out var serviceId)
            || !Guid.TryParse(_selectedTimeSlotId, out var timeSlotId)
            || string.IsNullOrWhiteSpace(_phoneNumber))
        {
            _error = "Please provide your phone number, branch, service, and time slot.";
            return;
        }

        try
        {
            _submitting = true;
            var ticket = await Api.BookAppointmentAsync(new BookAppointmentRequest(branchId, serviceId, timeSlotId, _phoneNumber.Trim()));
            if (ticket is null)
            {
                _error = "The appointment could not be booked.";
                return;
            }

            _success = $"Appointment {ticket.TicketNumber} booked for {ticket.ScheduledAt?.LocalDateTime:g}. Redirecting...";
            await Task.Delay(800);
            Navigation.NavigateTo($"/ticket/{ticket.Id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string FormatTimeSlot(TimeSlotResponse slot)
    {
        var remaining = slot.AvailableCount > 0 ? slot.AvailableCount : slot.Capacity - slot.BookedCount;
        var dayText = slot.Date is not null ? slot.Date.Value.ToShortDateString() : slot.DayOfWeek?.ToString() ?? "Any day";
        return $"{dayText} — {slot.StartTime:HH\\:mm} - {slot.EndTime:HH\\:mm} ({remaining} remaining)";
    }
}
