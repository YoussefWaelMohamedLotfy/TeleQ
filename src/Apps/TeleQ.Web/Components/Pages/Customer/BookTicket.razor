@page "/book"
@attribute [AllowAnonymous]
@inject TeleQApiClient Api
@inject NavigationManager Navigation

<PageTitle>Walk-In Ticket</PageTitle>

<h1 class="mb-4">Get a Walk-In Ticket</h1>

@if (_loading)
{
    <div class="d-flex align-items-center gap-2 text-muted">
        <Spinner Color="Color.Secondary" />
        <span>Loading branches and services...</span>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <Alert Color="Color.Danger" ShowDismiss="true">@_error</Alert>
    }

    @if (!string.IsNullOrWhiteSpace(_success))
    {
        <Alert Color="Color.Success">@_success</Alert>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Phone Number</label>
                    <BootstrapInput TValue="string" @bind-Value="_phoneNumber" PlaceHolder="01xxxxxxxxx" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Branch</label>
                    <Select TValue="string?" Items="@BranchItems" Value="@_selectedBranchId" ValueChanged="@OnBranchChangedAsync" PlaceHolder="Select a branch" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Service</label>
                    <Select TValue="string?" Items="@ServiceItems" Value="@_selectedServiceId" ValueChanged="@(v => _selectedServiceId = v)" PlaceHolder="Select a service" IsDisabled="@(string.IsNullOrEmpty(_selectedBranchId))" />
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <Button Color="Color.Primary" Icon="bi bi-ticket" Text="Issue Ticket" OnClick="SubmitAsync" Disabled="@_submitting" />
                <a class="btn btn-outline-secondary" href="/">Cancel</a>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<BranchResponse> _branches = [];
    private readonly List<ServiceResponse> _services = [];
    private string? _selectedBranchId;
    private string? _selectedServiceId;
    private string _phoneNumber = string.Empty;
    private string? _error;
    private string? _success;
    private bool _loading = true;
    private bool _submitting;

    private IEnumerable<SelectedItem> BranchItems =>
        _branches.Select(b => new SelectedItem(b.Id.ToString(), b.Name));

    private IEnumerable<SelectedItem> ServiceItems =>
        _services.Select(s => new SelectedItem(s.Id.ToString(), $"{s.Name} ({s.EstimatedDurationMinutes} min)"));

    protected override async Task OnInitializedAsync()
    {
        await LoadBranchesAsync();
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            _loading = true;
            _error = null;
            _branches.Clear();
            _branches.AddRange(await Api.GetBranchesAsync() ?? []);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnBranchChangedAsync(string? value)
    {
        _selectedBranchId = value;
        _selectedServiceId = null;
        _services.Clear();

        if (Guid.TryParse(_selectedBranchId, out var branchId))
        {
            try
            {
                _services.AddRange(await Api.GetServicesAsync(branchId) ?? []);
            }
            catch (Exception ex)
            {
                _error = ex.Message;
            }
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        _success = null;

        if (!Guid.TryParse(_selectedBranchId, out var branchId) || !Guid.TryParse(_selectedServiceId, out var serviceId) || string.IsNullOrWhiteSpace(_phoneNumber))
        {
            _error = "Please provide your phone number, branch, and service.";
            return;
        }

        try
        {
            _submitting = true;
            var ticket = await Api.IssueWalkInAsync(new IssueWalkInRequest(branchId, serviceId, _phoneNumber.Trim()));
            if (ticket is null)
            {
                _error = "The ticket could not be created.";
                return;
            }

            _success = $"Ticket {ticket.TicketNumber} created successfully. Redirecting...";
            await Task.Delay(800);
            Navigation.NavigateTo($"/ticket/{ticket.Id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }
}
