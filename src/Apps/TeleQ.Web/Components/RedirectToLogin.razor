@inject NavigationManager Navigation

<Alert Color="Color.Warning">Redirecting to the sign-in page...</Alert>

@code {
    protected override void OnInitialized()
    {
        var relativePath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(relativePath)}", forceLoad: true);
    }
}
