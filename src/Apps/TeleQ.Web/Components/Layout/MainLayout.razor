@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider

<BootstrapBlazorRoot>
<Layout IsFullSide="true"
        IsPage="true"
        IsAccordion="true"
        IsFixedHeader="true"
        IsFixedFooter="true"
        ShowCollapseBar="true"
        ShowFooter="true"
        MenuBarIcon="bi bi-list"
        Menus="@_menus">
    <Header>
        <div class="d-flex align-items-center w-100 gap-2 px-3">
            <span class="fw-semibold text-truncate d-none d-md-inline">Queue Management System</span>
            <div class="ms-auto d-flex align-items-center gap-2">
                <ThemeToggle />
                <AuthorizeView Context="authState">
                    <Authorized>
                        <span class="small d-none d-lg-inline text-truncate" style="max-width:180px">
                            <i class="bi bi-person-circle me-1"></i>@(authState.User.Identity?.Name ?? "User")
                        </span>
                        <a class="btn btn-outline-secondary btn-sm" href="/logout">
                            <i class="bi bi-box-arrow-right"></i>
                            <span class="d-none d-md-inline ms-1">Logout</span>
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-primary btn-sm" href="/login">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span class="d-none d-md-inline ms-1">Login</span>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </Header>
    <Side>
        <div class="layout-banner">
            <span class="layout-logo"><i class="bi bi-ticket-perforated"></i></span>
            <div class="layout-title">TeleQ</div>
        </div>
    </Side>
    <Main>
        <article class="p-3 p-md-4">
            @Body
        </article>
    </Main>
    <Footer>
        <div class="text-center text-muted small py-2">
            &copy; @DateTime.Now.Year TeleQ
        </div>
    </Footer>
</Layout>
</BootstrapBlazorRoot>

@code {
    private List<MenuItem> _menus = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var menus = new List<MenuItem>
        {
            new() { Text = "Home", Icon = "bi bi-house-door", Url = "/", Match = NavLinkMatch.All },
            new() { Text = "Walk-In Ticket", Icon = "bi bi-ticket", Url = "/book" },
            new() { Text = "Book Appointment", Icon = "bi bi-calendar-check", Url = "/appointment" }
        };

        if (user.Identity?.IsAuthenticated == true)
        {
            if (user.IsInRole("clerk") || user.IsInRole("admin"))
            {
                menus.Add(new MenuItem { Text = "Queue Desk", Icon = "bi bi-collection", Url = "/clerk/queue" });
                menus.Add(new MenuItem { Text = "Clerk Dashboard", Icon = "bi bi-speedometer2", Url = "/clerk/dashboard" });
            }

            if (user.IsInRole("admin"))
            {
                menus.Add(new MenuItem
                {
                    Text = "Admin",
                    Icon = "bi bi-shield-lock",
                    Items =
                    [
                        new() { Text = "Branches", Icon = "bi bi-building", Url = "/admin/branches" },
                        new() { Text = "Services", Icon = "bi bi-list-check", Url = "/admin/services" },
                        new() { Text = "Time Slots", Icon = "bi bi-clock", Url = "/admin/timeslots" },
                        new() { Text = "Reports", Icon = "bi bi-bar-chart", Url = "/admin/reports" }
                    ]
                });
            }
        }

        _menus = menus;
    }
}

